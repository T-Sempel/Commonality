{
  "name": "commonality",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend", "shared"],
  "scripts": {
    "dev": "concurrently -n web,api \"npm:dev --workspace=frontend\" \"npm:dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
